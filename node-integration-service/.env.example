# Node Integration Service - example environment configuration.
# Copy to .env for local development:  cp .env.example .env
# Never commit real credentials; this project needs none of them.

# HTTP server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Upstream integration (public keyless API used by default)
UPSTREAM_API_URL=https://dummyjson.com
# Outbound request timeout in milliseconds (50..60000)
UPSTREAM_TIMEOUT_MS=5000

# Rate limiting for the whole API (health endpoints are exempt)
RATE_LIMIT_MAX=240
RATE_LIMIT_WINDOW_SECONDS=60

# Graceful shutdown: in-flight requests may finish up to this long
SHUTDOWN_GRACE_MS=10000

# Readiness: probe upstream reachability (bounded HEAD + cache) and optionally
# treat upstream degradation as failure (503 from /ready).
READINESS_UPSTREAM_PROBE=true
READINESS_STRICT_UPSTREAM=false

# Demo route that intentionally blocks the event loop (off by default!)
ENABLE_DEMO_BLOCK=false
