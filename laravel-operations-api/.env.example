APP_NAME="Laravel Operations API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Required by Laravel 13. Use PHP 8.3+ (`php -v` must report >= 8.3).
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- PostgreSQL (the intended production database) ---------------------------
# Replace DB_PASSWORD with the password of your own role. Never commit real
# credentials: this file is safe to commit because it only holds placeholders.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=grids_app
DB_USERNAME=grids_app
DB_PASSWORD=
DB_SSLMODE=prefer

# Dedicated database used by the PHPUnit suite (migrated fresh on every run).
DB_TEST_DATABASE=grids_app_test

# --- Queue -------------------------------------------------------------------
# "database" is durable across process restarts (jobs live in the `jobs` table)
# which is the right trade-off for a single-node MVP. Production should use a
# managed broker such as SQS/Redis (see README "Queue setup").
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=jobs
DB_QUEUE_RETRY_AFTER=90

# The API is stateless (Sanctum bearer tokens), so sessions are not persisted.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local development writes order-confirmation mail to the log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="operations@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Order tax is applied on the subtotal. 0.00 keeps totals equal to the sum of
# the line totals; set e.g. 0.0825 for an 8.25% rate.
ORDER_TAX_RATE=0.00

# Lifetime (minutes) of a stock reservation created through the API.
STOCK_RESERVATION_TTL_MINUTES=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
