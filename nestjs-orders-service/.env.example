# ---------------------------------------------------------------------------
# Orders Service — example environment file
# ---------------------------------------------------------------------------
# Copy to `.env` for local development (`Copy-Item .env.example .env` on Windows).
# `.env` is gitignored and must never be committed.
#
# Every value below is validated on boot by `src/config/env.validation.ts`. A missing or
# malformed value aborts startup with a readable message instead of booting a half-configured
# application. Variables marked "required" have no default.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database --------------------------------------------------------------
# Default points at the isolated cluster created by `node scripts/local-postgres.mjs init`.
DATABASE_URL=postgresql://orders:orders@127.0.0.1:55432/orders_dev
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000

# --- Authentication --------------------------------------------------------
# Required. Minimum 32 characters. Generate with, e.g.:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# The value below is a development placeholder and is REJECTED when NODE_ENV=production.
JWT_SECRET=dev-only-change-me-0000000000000000000000000000
JWT_ISSUER=grids-orders-service
JWT_AUDIENCE=grids-api
JWT_ACCESS_TOKEN_TTL_SECONDS=3600

# --- Webhooks --------------------------------------------------------------
# Required. Minimum 32 characters. Shared secret used to verify the HMAC-SHA256 signature of
# inbound payment webhooks. A development placeholder that is REJECTED in production.
WEBHOOK_HMAC_SECRET=dev-only-webhook-secret-change-me-000000000000
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
WEBHOOK_PROCESSING_ENABLED=true
WEBHOOK_POLL_INTERVAL_MS=2000
WEBHOOK_BATCH_SIZE=10
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BACKOFF_BASE_MS=5000
WEBHOOK_PROCESSING_STALE_AFTER_MS=60000

# --- HTTP hardening --------------------------------------------------------
# Comma-separated allow-list. Empty means "no cross-origin browser access" (same-origin only).
CORS_ORIGINS=
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=100
TRUST_PROXY=false

# --- Observability ---------------------------------------------------------
LOG_LEVEL=log
LOG_JSON=false
SWAGGER_ENABLED=true
HEALTH_READINESS_TIMEOUT_MS=2000
